#!/usr/bin/env bash
set -euo pipefail

REGISTRY="${LAB_REGISTRY:-/srv/.lab-services.json}"
DEFAULT_ENV="prod"

# ── Colors ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

_info()  { echo -e "${CYAN}▸${NC} $*"; }
_ok()    { echo -e "${GREEN}✓${NC} $*"; }
_warn()  { echo -e "${YELLOW}!${NC} $*"; }
_err()   { echo -e "${RED}✗${NC} $*" >&2; }

# ── Registry helpers ──────────────────────────────────────────────────────

_get() {
    jq -r --arg svc "$1" --arg key "$2" '.[$svc][$key] // empty' "$REGISTRY"
}

_resolve_path() {
    local template="$1" env="$2"
    echo "${template//\{env\}/$env}"
}

_list_services() {
    jq -r 'keys[]' "$REGISTRY" | sort
}

_has_test_manifest() {
    local svc="$1"
    jq -e --arg svc "$svc" '.[$svc] | has("test") and (.test.suites != null or .test.command != null)' "$REGISTRY" >/dev/null 2>&1
}

_run_suite() {
    local svc="$1"
    local name="$2"
    local tier="$3"
    local phase="$4"
    local required="$5"
    local cmd="$6"
    local working_dir="$7"
    local compose_dir="$8"

    local exec_dir="$compose_dir"
    if [[ -n "$working_dir" && "$working_dir" != "." ]]; then
        if [[ "$working_dir" = /* ]]; then
            exec_dir="$working_dir"
        else
            exec_dir="${compose_dir}/${working_dir}"
        fi
    fi

    echo ""
    _info "Running test suite '${BOLD}${name}${NC}' (Tier ${tier}, ${phase})..."
    echo -e "  dir:     ${exec_dir}"
    echo -e "  command: ${cmd}"

    # The suite list is consumed through process substitution by the caller.
    # Test commands must not inherit that stdin or commands such as
    # `docker exec -i` can consume the remaining JSON suite definitions,
    # silently skipping later required suites.
    if ! (cd "$exec_dir" && eval "$cmd" < /dev/null); then
        _err "Test suite '${name}' FAILED"
        return 1
    fi
    _ok "Test suite '${name}' PASSED"
    return 0
}

_run_pre_deploy_gate() {
    local svc="$1"
    local compose_dir="$2"
    local env="$3"

    if ! _has_test_manifest "$svc"; then
        _warn "${svc}: legacy service without test manifest. Pre-deploy gate skipped (will become required)."
        return 0
    fi

    local suites_json
    suites_json=$(jq -c --arg svc "$svc" '.[$svc].test.suites // []' "$REGISTRY")
    local suite_count
    suite_count=$(echo "$suites_json" | jq '. | length')

    if [[ "$suite_count" -eq 0 ]]; then
        local simple_cmd
        simple_cmd=$(jq -r --arg svc "$svc" '.[$svc].test.command // empty' "$REGISTRY")
        if [[ -n "$simple_cmd" ]]; then
            _info "Running pre-deploy test command for ${svc}..."
            if ! (cd "$compose_dir" && eval "$simple_cmd"); then
                _err "Pre-deploy test failed for ${svc}"
                return 1
            fi
            return 0
        fi
        _warn "${svc}: test block defined but no suites configured."
        return 0
    fi

    _info "Running required pre-deploy test suites for ${svc}..."
    local executed=0

    while read -r suite; do
        [[ -z "$suite" ]] && continue
        local s_name s_tier s_phase s_req s_cmd s_dir
        s_name=$(echo "$suite" | jq -r '.name')
        s_tier=$(echo "$suite" | jq -r '.tier // 1')
        s_phase=$(echo "$suite" | jq -r '.phase // "pre_deploy"')
        s_req=$(echo "$suite" | jq -r '.required // true')
        s_cmd=$(echo "$suite" | jq -r '.command')
        s_dir=$(echo "$suite" | jq -r '.working_dir // "."')

        if [[ "$s_phase" != "pre_deploy" || "$s_req" != "true" ]]; then
            continue
        fi

        executed=$((executed + 1))
        if ! _run_suite "$svc" "$s_name" "$s_tier" "$s_phase" "$s_req" "$s_cmd" "$s_dir" "$compose_dir"; then
            _err "Pre-deploy test gate FAILED on suite '${s_name}' for ${svc}. Aborting deployment."
            return 1
        fi
    done < <(echo "$suites_json" | jq -c '.[]')

    if [[ "$executed" -eq 0 ]]; then
        _warn "${svc}: no required pre-deploy suites found in manifest."
    else
        _ok "Pre-deploy test gate PASSED (${executed} suite(s) verified)"
    fi
    return 0
}

_run_post_deploy_gate() {
    local svc="$1"
    local compose_dir="$2"
    local env="$3"

    if ! _has_test_manifest "$svc"; then
        return 0
    fi

    local suites_json
    suites_json=$(jq -c --arg svc "$svc" '.[$svc].test.suites // []' "$REGISTRY")
    local executed=0

    while read -r suite; do
        [[ -z "$suite" ]] && continue
        local s_name s_tier s_phase s_req s_cmd s_dir
        s_name=$(echo "$suite" | jq -r '.name')
        s_tier=$(echo "$suite" | jq -r '.tier // 5')
        s_phase=$(echo "$suite" | jq -r '.phase // "post_deploy"')
        s_req=$(echo "$suite" | jq -r '.required // true')
        s_cmd=$(echo "$suite" | jq -r '.command')
        s_dir=$(echo "$suite" | jq -r '.working_dir // "."')

        if [[ "$s_phase" != "post_deploy" || "$s_req" != "true" ]]; then
            continue
        fi

        executed=$((executed + 1))
        _info "Running post-deploy canary suite '${s_name}' for ${svc}..."
        if ! _run_suite "$svc" "$s_name" "$s_tier" "$s_phase" "$s_req" "$s_cmd" "$s_dir" "$compose_dir"; then
            _err "Post-deploy canary '${s_name}' FAILED for ${svc}!"
            return 1
        fi
    done < <(echo "$suites_json" | jq -c '.[]')

    if [[ "$executed" -gt 0 ]]; then
        _ok "Post-deploy acceptance canary PASSED (${executed} suite(s))"
    fi
    return 0
}

# ── Commands ──────────────────────────────────────────────────────────────

cmd_deploy() {
    local svc="${1:?Usage: lab deploy <service> [dev|prod] [--no-cache] [--skip-test-gate]}"
    if [[ "$svc" == "--help" || "$svc" == "-h" ]]; then
        echo "Usage: lab deploy <service> [dev|prod] [--no-cache] [--skip-test-gate]"
        echo ""
        echo "Pull, verify test gates, build, start, health-check, and tail logs for a service."
        echo ""
        echo "Options:"
        echo "  dev|prod            Target environment. Required for split-env services"
        echo "                      (e.g. voice_bridge). Defaults to prod if omitted —"
        echo "                      a warning is shown for split-env services."
        echo "  --no-cache          Force a full Docker rebuild (skip layer cache)."
        echo "  --skip-test-gate    Bypass pre-deploy test gate verification (emergency only)."
        return 0
    fi
    shift
    local env=""
    local no_cache=""
    local skip_test_gate=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            dev|prod) env="$1" ;;
            --no-cache) no_cache="--no-cache" ;;
            --skip-test-gate) skip_test_gate="true" ;;
            -h|--help) cmd_deploy --help; return 0 ;;
            *) _err "Unknown argument: $1"; return 1 ;;
        esac
        shift
    done

    if ! jq -e --arg svc "$svc" 'has($svc)' "$REGISTRY" >/dev/null 2>&1; then
        _err "Unknown service: $svc"
        echo "Available services:"
        _list_services | sed 's/^/  /'
        return 1
    fi

    local env_mode
    env_mode=$(_get "$svc" "env_mode")

    if [[ -z "$env" ]]; then
        env="$DEFAULT_ENV"
        if [[ "$env_mode" == "split" ]]; then
            _warn "${svc} has split environments — deploying ${BOLD}${env}${NC}${YELLOW}. Pass 'dev' or 'prod' to be explicit.${NC}"
        fi
    fi

    local compose repo container health
    compose=$(_resolve_path "$(_get "$svc" "compose")" "$env")
    repo=$(_resolve_path "$(_get "$svc" "repo")" "$env")
    container=$(_resolve_path "$(_get "$svc" "container")" "$env")
    health=$(_resolve_path "$(_get "$svc" "health")" "$env")

    local branch
    [[ "$env" == "prod" ]] && branch="main" || branch="dev"

    echo ""
    echo -e "${BOLD}Deploying ${CYAN}${svc}${NC} ${BOLD}(${env})${NC}"
    echo -e "  compose:   ${compose}"
    echo -e "  repo:      ${repo}"
    echo -e "  branch:    ${branch}"
    echo ""

    local compose_dir compose_file
    compose_dir=$(dirname "$compose")
    compose_file=$(basename "$compose")

    if [[ -n "$repo" ]]; then
        _info "Pulling latest from ${branch}..."
        if ! (cd "$repo" && git pull origin "$branch" 2>&1); then
            _err "git pull failed"
            return 1
        fi
    else
        _warn "No git repo configured — skipping git pull"
    fi

    # Step 2: Pre-deploy test gate
    if [[ -n "$skip_test_gate" ]]; then
        _warn "SKIPPING pre-deploy test gate for ${svc} (--skip-test-gate specified)"
    else
        if ! _run_pre_deploy_gate "$svc" "$compose_dir" "$env"; then
            return 1
        fi
    fi

    # Step 3a: pre-build hook (e.g. frontend build)
    local pre_build
    pre_build=$(_get "$svc" "pre_build")
    if [[ -n "$pre_build" ]]; then
        _info "Running pre-build hook..."
        if ! (cd "$compose_dir" && eval "$pre_build" 2>&1); then
            _err "Pre-build hook failed"
            return 1
        fi
    fi

    # Step 3b: docker build or pull
    if [[ -n "$repo" ]]; then
        _info "Building (${no_cache:-cached})..."
        if ! (cd "$compose_dir" && docker compose -f "$compose_file" build $no_cache 2>&1); then
            _err "Build failed"
            return 1
        fi
    else
        _info "Pulling latest images..."
        if ! (cd "$compose_dir" && docker compose -f "$compose_file" pull 2>&1); then
            _err "Image pull failed"
            return 1
        fi
    fi

    # Step 4: up (--force-recreate ensures bind-mounted config changes take effect)
    _info "Starting container..."
    if ! (cd "$compose_dir" && docker compose -f "$compose_file" up -d --force-recreate 2>&1); then
        _err "Failed to start container"
        return 1
    fi

    # Step 5: health check
    if [[ -n "$health" ]]; then
        _info "Waiting for health check..."
        local attempts=0
        local max_attempts
        max_attempts=$(_get "$svc" "health_attempts")
        max_attempts=${max_attempts:-15}
        while [[ $attempts -lt $max_attempts ]]; do
            sleep 2
            if eval "$health" >/dev/null 2>&1; then
                _ok "Health check passed"
                break
            fi
            attempts=$((attempts + 1))
        done
        if [[ $attempts -ge $max_attempts ]]; then
            _warn "Health check did not pass after ${max_attempts} attempts"
            _info "Checking logs..."
            docker logs "$container" --tail 20 2>&1
            return 1
        fi
    else
        sleep 3
        if docker ps --format '{{.Names}}' | grep -q "^${container}$"; then
            _ok "Container running (no health endpoint)"
        else
            _err "Container not running"
            docker logs "$container" --tail 20 2>&1
            return 1
        fi
    fi

    # Step 6: Post-deploy acceptance canary gate
    if ! _run_post_deploy_gate "$svc" "$compose_dir" "$env"; then
        _err "Deployment completed but post-deploy canary verification FAILED"
        return 1
    fi

    # Step 7: clean logs check
    _info "Last few log lines:"
    docker logs "$container" --tail 5 2>&1 | sed 's/^/  /'

    echo ""
    _ok "${BOLD}${svc}${NC} deployed successfully (${env})"
}

cmd_test() {
    local svc="${1:?Usage: lab test <service> [--tier N] [--live] [dev|prod]}"
    if [[ "$svc" == "--help" || "$svc" == "-h" ]]; then
        echo "Usage: lab test <service> [--tier N] [--live] [dev|prod]"
        echo ""
        echo "Run tests for a service. Uses structured test manifest from"
        echo "services.json if present; otherwise falls back to local venv"
        echo "or docker build."
        echo ""
        echo "Options:"
        echo "  --tier N     Run only suites matching Tier N (1=unit, 2=integration, 3=e2e, 4=browser, 5=live)"
        echo "  --live       Include post-deploy / live acceptance canary suites (Tier 5)"
        echo "  dev|prod     Target environment for split-env services (default: prod)"
        return 0
    fi
    shift

    local tier_filter=""
    local live_mode=""
    local env="$DEFAULT_ENV"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tier) tier_filter="${2:?--tier requires a number (1-5)}"; shift ;;
            --live) live_mode="true" ;;
            dev|prod) env="$1" ;;
            -h|--help) cmd_test --help; return 0 ;;
            *) _err "Unknown argument: $1"; return 1 ;;
        esac
        shift
    done

    if ! jq -e --arg svc "$svc" 'has($svc)' "$REGISTRY" >/dev/null 2>&1; then
        _err "Unknown service: $svc"
        return 1
    fi

    local compose
    compose=$(_resolve_path "$(_get "$svc" "compose")" "$env")
    local compose_dir
    compose_dir=$(dirname "$compose")

    if _has_test_manifest "$svc"; then
        local suites_json
        suites_json=$(jq -c --arg svc "$svc" '.[$svc].test.suites // []' "$REGISTRY")
        local suite_count
        suite_count=$(echo "$suites_json" | jq '. | length')

        if [[ "$suite_count" -gt 0 ]]; then
            local executed=0
            local failed=0

            while read -r suite; do
                [[ -z "$suite" ]] && continue
                local s_name s_tier s_phase s_req s_cmd s_dir
                s_name=$(echo "$suite" | jq -r '.name')
                s_tier=$(echo "$suite" | jq -r '.tier // 1')
                s_phase=$(echo "$suite" | jq -r '.phase // "pre_deploy"')
                s_req=$(echo "$suite" | jq -r '.required // true')
                s_cmd=$(echo "$suite" | jq -r '.command')
                s_dir=$(echo "$suite" | jq -r '.working_dir // "."')

                # Filter by tier if specified
                if [[ -n "$tier_filter" && "$s_tier" != "$tier_filter" ]]; then
                    continue
                fi

                # Filter by phase: pre_deploy by default; post_deploy only if --live or tier 5
                if [[ -z "$live_mode" && "$tier_filter" != "5" && "$s_phase" == "post_deploy" ]]; then
                    continue
                fi

                executed=$((executed + 1))
                if ! _run_suite "$svc" "$s_name" "$s_tier" "$s_phase" "$s_req" "$s_cmd" "$s_dir" "$compose_dir"; then
                    failed=$((failed + 1))
                    if [[ "$s_req" == "true" ]]; then
                        _err "Required test suite '${s_name}' failed for ${svc}"
                        return 1
                    fi
                fi
            done < <(echo "$suites_json" | jq -c '.[]')

            if [[ "$executed" -eq 0 ]]; then
                _err "No matching test suites executed for ${svc} (filter tier=${tier_filter:-any}, live=${live_mode:-false})"
                return 1
            fi

            if [[ "$failed" -gt 0 ]]; then
                _err "${failed} test suite(s) failed for ${svc}"
                return 1
            fi

            echo ""
            _ok "All executed test suites PASSED for ${svc}"
            return 0
        else
            # Simple command manifest
            local simple_cmd
            simple_cmd=$(jq -r --arg svc "$svc" '.[$svc].test.command // empty' "$REGISTRY")
            if [[ -n "$simple_cmd" ]]; then
                _info "Running test command for ${svc}..."
                (cd "$compose_dir" && eval "$simple_cmd")
                return $?
            fi
        fi
    fi

    # Fallback to legacy behavior
    _warn "${svc}: legacy service without test manifest in services.json. Falling back to default pytest."
    if [[ -f "${compose_dir}/.venv/bin/python" ]]; then
        _info "Running pytest via local venv..."
        (cd "$compose_dir" && .venv/bin/python -m pytest tests/ -x -q)
    else
        _info "No local venv found. Running pytest via docker build..."
        local compose_file
        compose_file=$(basename "$compose")
        (cd "$compose_dir" && docker compose -f "$compose_file" build --no-cache)
    fi
}

cmd_logs() {
    local svc="${1:?Usage: lab logs <service> [--tail N] [dev|prod]}"
    if [[ "$svc" == "--help" || "$svc" == "-h" ]]; then
        echo "Usage: lab logs <service> [--tail N] [dev|prod]"
        echo ""
        echo "View container logs."
        echo ""
        echo "Options:"
        echo "  --tail N     Number of lines to show (default: 50)."
        echo "  dev|prod     Target environment for split-env services (default: prod)."
        return 0
    fi
    shift
    local tail_n=50
    local env="$DEFAULT_ENV"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tail) tail_n="${2:?--tail requires a number}"; shift ;;
            dev|prod) env="$1" ;;
            -h|--help) cmd_logs --help; return 0 ;;
            *) _err "Unknown argument: $1"; return 1 ;;
        esac
        shift
    done

    if ! jq -e --arg svc "$svc" 'has($svc)' "$REGISTRY" >/dev/null 2>&1; then
        _err "Unknown service: $svc"
        return 1
    fi

    local container
    container=$(_resolve_path "$(_get "$svc" "container")" "$env")
    docker logs "$container" --tail "$tail_n" 2>&1
}

cmd_health() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: lab health [service]"
        echo ""
        echo "Check health of all services, or a single service if specified."
        return 0
    fi
    local filter="${1:-}"

    echo -e "${BOLD}Service Health${NC}"
    echo ""

    for svc in $(_list_services); do
        if [[ -n "$filter" && "$svc" != "$filter" ]]; then
            continue
        fi

        local container health
        container=$(_resolve_path "$(_get "$svc" "container")" "$DEFAULT_ENV")
        health=$(_resolve_path "$(_get "$svc" "health")" "$DEFAULT_ENV")

        local running
        running=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -c "^${container}$" || true)

        if [[ "$running" -eq 0 ]]; then
            echo -e "  ${RED}●${NC} ${svc} — stopped"
            continue
        fi

        if [[ -n "$health" ]]; then
            if eval "$health" >/dev/null 2>&1; then
                echo -e "  ${GREEN}●${NC} ${svc} — healthy"
            else
                echo -e "  ${YELLOW}●${NC} ${svc} — running, health check failed"
            fi
        else
            echo -e "  ${GREEN}●${NC} ${svc} — running (no health endpoint)"
        fi
    done
    echo ""
}

cmd_list() {
    echo -e "${BOLD}Registered Services${NC}"
    echo ""
    printf "  %-20s %-8s %s\n" "SERVICE" "ENV" "COMPOSE"
    printf "  %-20s %-8s %s\n" "-------" "---" "-------"
    for svc in $(_list_services); do
        local compose env_mode
        compose=$(_get "$svc" "compose")
        env_mode=$(_get "$svc" "env_mode")
        printf "  %-20s %-8s %s\n" "$svc" "$env_mode" "$compose"
    done
    echo ""
}

# ── Home Assistant ────────────────────────────────────────────────────────

HA_URL="https://homeassistant.burnses.net"
HA_TOKEN_FILE="/srv/shared/mcp-gateway/.env"

_ha_token() {
    grep '^HA_TOKEN=' "$HA_TOKEN_FILE" 2>/dev/null | cut -d= -f2-
}

_ha_api() {
    local method="$1" path="$2"
    local token
    token=$(_ha_token)
    if [[ -z "$token" ]]; then
        _err "HA_TOKEN not found in $HA_TOKEN_FILE"
        return 1
    fi
    curl -sf -X "$method" \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" \
        "${HA_URL}${path}"
}

cmd_ha() {
    local subcmd="${1:?Usage: lab ha <deploy|check|reload|restart>}"
    if [[ "$subcmd" == "--help" || "$subcmd" == "-h" ]]; then
        echo "Usage: lab ha <deploy|check|reload|restart>"
        echo ""
        echo "  deploy   Validate config and reload all domains"
        echo "  check    Validate HA configuration only"
        echo "  reload   Reload all reloadable HA domains"
        echo "  restart  Full HA core restart (30-60s downtime)"
        return 0
    fi
    shift

    case "$subcmd" in
        check)   _ha_check ;;
        reload)  _ha_reload ;;
        deploy)  _ha_check && _ha_reload ;;
        restart) _ha_restart ;;
        *)
            _err "Unknown ha subcommand: $subcmd"
            echo "Usage: lab ha <deploy|check|reload|restart>"
            return 1
            ;;
    esac
}

_ha_check() {
    _info "Validating HA configuration..."
    local result
    result=$(_ha_api POST "/api/config/core/check_config") || {
        _err "Failed to reach HA API"
        return 1
    }
    local check_result
    check_result=$(echo "$result" | jq -r '.result // "unknown"')
    if [[ "$check_result" == "valid" ]]; then
        _ok "Configuration is valid"
        return 0
    else
        _err "Configuration is invalid:"
        echo "$result" | jq -r '.errors // .error // .' 2>/dev/null | sed 's/^/  /'
        return 1
    fi
}

_ha_reload() {
    _info "Reloading HA domains..."

    local domains=(
        "homeassistant/reload_core_config"
        "automation/reload"
        "script/reload"
        "scene/reload"
        "rest_command/reload"
        "template/reload"
        "input_boolean/reload"
        "input_number/reload"
        "input_select/reload"
        "input_text/reload"
        "group/reload"
    )

    local failed=0
    for domain_action in "${domains[@]}"; do
        local domain="${domain_action%%/*}"
        if _ha_api POST "/api/services/${domain_action}" >/dev/null 2>&1; then
            echo -e "  ${GREEN}✓${NC} ${domain}"
        else
            echo -e "  ${YELLOW}⚠${NC} ${domain} (reload not available or failed)"
            failed=$((failed + 1))
        fi
    done

    if [[ $failed -eq 0 ]]; then
        _ok "All domains reloaded"
    else
        _warn "${failed} domain(s) could not be reloaded (may not support hot-reload)"
    fi
}

_ha_restart() {
    _warn "Restarting HA core (this takes 30-60 seconds)..."
    _ha_api POST "/api/services/homeassistant/restart" >/dev/null 2>&1 || true
    _info "Restart initiated. HA will be briefly unavailable."
}

# ── Main ──────────────────────────────────────────────────────────────────

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    deploy)  cmd_deploy "$@" ;;
    test)    cmd_test "$@" ;;
    logs)    cmd_logs "$@" ;;
    health)  cmd_health "$@" ;;
    list)    cmd_list "$@" ;;
    ha)      cmd_ha "$@" ;;
    help|--help|-h)
        echo "Usage: lab <command> [args]"
        echo ""
        echo "Commands:"
        echo "  deploy <service> [dev|prod] [--no-cache] [--skip-test-gate]  Build and deploy a service"
        echo "  test   <service> [--tier N] [--live] [dev|prod]              Run tests for a service"
        echo "  logs   <service> [--tail N] [dev|prod]     View container logs"
        echo "  health [service]                           Check service health"
        echo "  list                                       List all registered services"
        echo ""
        echo "  ha deploy    Validate HA config and reload all domains"
        echo "  ha check     Validate HA config only"
        echo "  ha reload    Reload all reloadable HA domains"
        echo "  ha restart   Full HA core restart"
        echo ""
        echo "Services:"
        _list_services | sed 's/^/  /'
        ;;
    *)
        _err "Unknown command: $cmd"
        echo "Run 'lab help' for usage."
        exit 1
        ;;
esac
